PORT=3333
DATABASE_URL=
CORS_ORIGIN=

# Secret HS256 partagé avec le service d'authentification (vérifie la
# signature des JWT reçus — voir JwtAuthGuard).
JWT_SECRET=

# Passerelle unique du CHU — remplace toutes les URLs directes de services
# tiers (Accueil, Users, CHU, Prescription, Notification, Dossier patient,
# Upload...). Un seul lien à maintenir.
GATEWAY_URL=

# Token de service (compte-à-compte) utilisé UNIQUEMENT par les tâches de
# fond sans requête utilisateur (cron de synchronisation des prescriptions).
# Tout appel porté par une requête utilisateur utilise le JWT de l'appelant
# à la place — chuId et serviceId n'y sont plus des variables séparées, ils
# sont dérivés de ce même token pour les tâches de fond, et du JWT de
# l'utilisateur connecté sinon.
PRESCRIPTION_API_TOKEN=

INTERNAL_API_KEY=

# Prescripteur de repli (CHEF_SERVICE) — à renseigner une fois le premier
# vrai compte CHEF_SERVICE créé côté auth-service/user-services.
DEFAULT_CHEF_SERVICE_USER_ID=
