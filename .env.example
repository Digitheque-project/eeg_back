PORT=3001
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=change-me
CORS_ORIGIN=https://mon-frontend.example.com

# ─────────────────────────────────────────────────────────────────────────
# Config d'infrastructure externe — TOUTE lue via src/common/config/
# external-services.config.ts (source unique). Ne jamais coder une URL ou
# un id de service en dur ailleurs dans le code : le jour du déploiement sur
# l'infra officielle du CHU (qui ne dort jamais, contrairement à ces
# instances Render/Railway de dev), la bascule doit être un simple
# changement de ces variables, jamais une modif de code.
#
# IMPORTANT : chaque URL ci-dessous doit être UNIQUEMENT la base URL
# (protocole + hôte). Aucun préfixe ni suffixe de chemin : pas de
# « baseUrl/accueil », « baseUrl/prescriptions », etc. Les chemins d'API
# (/accueil, /prescriptions, /dossier-patient…) sont portés par le code
# (voir src/common/utils/url.util.ts → withBasePath).
# ─────────────────────────────────────────────────────────────────────────

# Identité de ce CHU et de ce service EEG dans le système multi-CHU/multi-service
CHU_ID=uuid-du-chu
SSO_EEG_SERVICE_ID=uuid-service-eeg-dans-le-registre-service-service

# Prescripteur de repli (CHEF_SERVICE) — à renseigner une fois le premier
# vrai compte CHEF_SERVICE créé côté auth-service/user-services
DEFAULT_CHEF_SERVICE_USER_ID=

# Service de notification partagé (déjà utilisé par le module Prescription)
NOTIFICATION_SERVICE_URL=https://notification-service.example.com

# Stockage centralisé des fichiers (images de trace EEG) — auth via le
# token de l'utilisateur connecté (forwardé), voir upload-client.service.ts
UPLOAD_SERVICE_URL=https://upload-service.example.com

# Dossier patient partagé (antécédents, diagnostics, examens physiques...)
DOSSIER_PATIENT_API_URL=https://dossier-patient.example.com

# Service Accueil — source de vérité des patients (ne JAMAIS dupliquer ces données en local)
ACCUEIL_API_URL=https://accueil.example.com

# Registre "service-service" — résout un service (ex: EEG) par son id, PAS le CHU (voir CHU_SERVICE_URL)
CHU_API_URL=https://service-service.example.com

# Service User — résolution des prescripteurs par ID
USER_SERVICE_URL=https://user-services.example.com
INTERNAL_API_KEY=internal-key-example

# Service CHU — infos CHU (GET /chu/{id}) + prises en charge (entreprises partenaires)
CHU_SERVICE_URL=https://chu-service.example.com

# Service Prescription — source des prescriptions EEG (polling, remplace l'ancien push)
PRESCRIPTION_API_URL=https://prescription-backend.example.com
PRESCRIPTION_API_TOKEN=   # à définir par déploiement
