PORT=3333
DATABASE_URL=
CORS_ORIGIN=

# Secret HS256 partagé avec le service d'authentification (vérifie la
# signature des JWT reçus — voir JwtAuthGuard — ET signe le jeton de
# service auto-généré pour les tâches de fond, voir signServiceToken).
# DOIT être le vrai secret partagé par tout l'écosystème SSO (confirmé :
# secret123, partagé avec la gateway et les autres services), pas une
# valeur propre à ce service — sinon aucun JWT utilisateur ne se vérifie.
JWT_SECRET=

# Passerelle unique du CHU — remplace toutes les URLs directes de services
# tiers (Accueil, Users, CHU, Prescription, Notification, Dossier patient,
# Upload). Un seul lien à maintenir.
GATEWAY_URL=

# Identité PROPRE de ce déploiement dans le registre multi-CHU/multi-service
# (pas un token ni une donnée empruntée à un tiers) — nécessaire uniquement
# pour la tâche de fond sans requête utilisateur (cron de synchronisation),
# qui n'a structurellement aucun JWT d'où extraire ces valeurs. Tout appel
# porté par une requête utilisateur utilise req.user.chuId/serviceId (JWT de
# l'appelant) à la place.
CHU_ID=
SSO_EEG_SERVICE_ID=

INTERNAL_API_KEY=

# Prescripteur de repli (CHEF_SERVICE) — à renseigner une fois le premier
# vrai compte CHEF_SERVICE créé côté auth-service/user-services.
DEFAULT_CHEF_SERVICE_USER_ID=
