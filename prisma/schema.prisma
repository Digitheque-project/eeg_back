generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatutDemande {
  CREEE
  PLANIFIEE
  EN_COURS
  RESULTAT_DISPONIBLE
  ANNULEE
}

enum TypeEEG {
  STANDARD
  SOMMEIL
  AMBULATOIRE
  VIDEO_EEG
  EEG
}

enum NiveauUrgence {
  STAT
  URGENTE
  NORMALE
}

enum StatutRdv {
  EN_ATTENTE
  REALISE
  NON_REALISE
  ANNULE
}

enum TypeNotification {
  ALERTE_CRITIQUE
  ALERTE_URGENTE
  NOUVELLE_DEMANDE
  A_INTERPRETER
  RAPPORT
  SYSTEME
}

enum TypeActivite {
  VALIDATION
  NOUVEL_EXAMEN
  SYSTEME
  ARCHIVE
}

enum ActionAudit {
  CREATION
  CONSULTATION
  MODIFICATION
  VALIDATION
  ANNULATION
  IMPRESSION
  ACK
}

// EEG-local dossier numbering for a patient (patientId is an external id from Accueil).
// Patients themselves are no longer stored here — Accueil is the source of truth.
model EegDossier {
  id        String   @id @default(uuid())
  patientId String   @unique
  idDossier String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("eeg_dossier")
}

// Il n'y a plus de modèle Utilisateur local : identité, rôle et permissions
// viennent uniquement du service auth externe (JWT décodé par JwtAuthGuard).
// Tous les *Id ci-dessous (prescripteurId, technicienId, medecinValidateurId,
// auteurId, assigneeUserId, userId, utilisateurId) sont de simples ids
// externes — résolus à la volée via UserLookupService quand un nom
// d'affichage est nécessaire, jamais via une relation Prisma.
model EegDemande {
  id                       String        @id @default(uuid())
  numeroEEG                String        @unique
  patientId                String
  prescripteurId           String?
  technicienId             String?
  typeEEG                  TypeEEG
  urgence                  NiveauUrgence
  motifPrescription        String
  statut                   StatutDemande @default(CREEE)
  episodeSoinsId           String
  prescriptionSourceId     String?       @unique
  prescriptionParentId     String?
  prescripteurExterneNom    String?
  prescripteurExternePrenom String?
  prescripteurExterne       Boolean     @default(false)
  dateCreation              DateTime      @default(now())
  dateRDV                  DateTime?
  dateRealisation          DateTime?
  dateValidation           DateTime?
  motifAnnulation          String?

  // Snapshot clinique pris à la prescription (chez prescription_back) —
  // affiché en lecture seule à l'interprétation (CHEF_SERVICE) au lieu
  // d'être ressaisi : voir TabC_CompteRendu côté eeg_front.
  aeActuel          String?
  agePremiereCrise  String?
  dpm               String?
  typeCrise         String?
  dateDerniereCrise String?

  resultat      EegResultat?
  notifications EegNotification[]
  audits        EegAudit[]
  rdv           EegRdv?

  @@map("eeg_demande")
}

model EegRdv {
  id                      String        @id @default(uuid())
  patientId               String
  prescripteurId          String?
  demandeId               String?       @unique
  typeEEG                 String
  // Une seule salle pour l'instant (pas de sélection utilisateur) — le
  // champ existe déjà pour ne pas tout refaire quand plusieurs salles
  // réelles seront disponibles.
  salle                   String        @default("Salle EEG 1")
  priorite                NiveauUrgence
  statut                  StatutRdv     @default(EN_ATTENTE)
  dateRdv                 DateTime
  heureDebut              String
  heureFin                String
  dureeMinutes            Int
  renseignementClinique   String?
  dateRealisation         DateTime?
  technicienRealisateurId String?
  createdAt               DateTime      @default(now())

  demande       EegDemande?       @relation(fields: [demandeId], references: [id])
  notifications EegNotification[]

  @@map("eeg_rdv")
}

// Compte rendu EEG — champs alignés sur le formulaire papier réel du CHU
// Andrainjato (service Neurologie). Seule cette section (CLINIQUE,
// INTERPRETATION, CONCLUSION, CONDUITE A TENIR) est saisie manuellement ;
// le reste du document (identité patient, prescripteur, personnel, dates)
// est déjà connu ailleurs dans le système et rempli automatiquement.
model EegResultat {
  id                  String    @id @default(uuid())
  demandeId           String    @unique
  fichierImagePath    String?
  nomFichierImage     String?
  dureeEnregistrement Int?

  // CLINIQUE
  aeActuel          String?
  age1ereCrise      String?
  dpm               String?
  typeCrises        String?
  autresRc          String?
  dateDerniereCrise String?

  // INTERPRETATION
  activiteDeFond    String?
  anomaliesAuRepos  String?
  testActivationHpn String?
  testActivationSli String?

  // CONCLUSION / CONDUITE A TENIR
  conclusion     String?
  conduiteATenir String?

  // Champs du compte rendu officiel CHUA absents jusqu'ici — le front les
  // affichait « Néant » faute de colonne côté back.
  // etatEveil : "veille" | "sommeil" (état du patient pendant l'examen).
  // conditions : comportement, artéfacts, étape non réalisable...
  // notes complémentaires : texte libre ajouté sous CONCLUSION / CONDUITE.
  etatEveil                    String?
  conditions                   String?
  noteComplementaireConclusion String?
  noteComplementaireConduite   String?

  medecinValidateurId String?
  dateValidation      DateTime?
  estImmutable        Boolean   @default(false)
  estCritique         Boolean   @default(false)
  version             Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  demande        EegDemande         @relation(fields: [demandeId], references: [id])
  rectifications EegRectification[]

  @@map("eeg_resultat")
}

model EegRectification {
  id                String   @id @default(uuid())
  resultatId        String
  auteurId          String
  motif             String
  ancienneVersion   Json
  nouvelleVersion   Json
  dateRectification DateTime @default(now())

  resultat EegResultat @relation(fields: [resultatId], references: [id])

  @@map("eeg_rectification")
}

model EegNotification {
  id             String           @id @default(uuid())
  niveau         NiveauUrgence
  type           TypeNotification
  titre          String
  message        String
  patientId      String?
  patientTexte   String?
  horodatage     DateTime         @default(now())
  lu             Boolean          @default(false)
  assigneeUserId String?
  rdvId          String?
  demandeId      String?
  dateLecture    DateTime?
  // Rôle EEG concerné (TECHNICIEN | CHEF_SERVICE) — null = visible par
  // tous (compat notifications déjà existantes). MAJOR_SERVICE (rôle de
  // supervision) voit toujours tout, filtre ignoré pour lui.
  roleCible      String?

  rdv     EegRdv?                 @relation(fields: [rdvId], references: [id])
  demande EegDemande?             @relation(fields: [demandeId], references: [id])
  actions EegNotificationAction[]

  @@map("eeg_notification")
}

model EegNotificationAction {
  id             String @id @default(uuid())
  notificationId String
  label          String
  style          String
  ordre          Int

  notification EegNotification @relation(fields: [notificationId], references: [id])

  @@map("eeg_notification_action")
}

model EegActivite {
  id          String       @id @default(uuid())
  ts          DateTime     @default(now())
  type        TypeActivite
  description String
  userId      String?
  patientId   String?

  @@map("eeg_activite")
}

model EegAudit {
  id            String      @id @default(uuid())
  utilisateurId String
  role          String
  action        ActionAudit
  entite        String
  entiteId      String
  patientId     String
  detail        Json?
  dateAction    DateTime    @default(now())
  demandeId     String?

  demande EegDemande? @relation(fields: [demandeId], references: [id])

  @@map("eeg_audit")
}

// Personnel du service de Neurologie affiché dans l'en-tête / le pied du
// compte rendu EEG officiel (chef de service, médecins, major, techniciens,
// téléphone RDV). Singleton métier : une seule ligne, éditable par le
// CHEF_SERVICE / MAJOR_SERVICE via PUT /eeg/config/personnel-service.
// Ce n'est PAS un annuaire d'utilisateurs (celui-ci reste user-services) :
// juste les libellés imprimés sur le document papier.
model PersonnelServiceNeurologie {
  id             String   @id @default(uuid())
  chefDeService  String
  medecins       String[]
  majorDeService String
  techniciens    String[]
  telephoneRdv   String
  updatedAt      DateTime @updatedAt

  @@map("personnel_service_neurologie")
}
