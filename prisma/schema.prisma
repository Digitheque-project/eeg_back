generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatutDemande {
  CREEE
  PLANIFIEE
  EN_COURS
  RESULTAT_DISPONIBLE
  ANNULEE
}

enum TypeEEG {
  STANDARD
  SOMMEIL
  AMBULATOIRE
  VIDEO_EEG
}

enum NiveauUrgence {
  STAT
  URGENTE
  NORMALE
}

enum StatutRdv {
  EN_ATTENTE
  REALISE
  NON_REALISE
  ANNULE
}

enum TypeNotification {
  ALERTE_CRITIQUE
  ALERTE_URGENTE
  NOUVELLE_DEMANDE
  RAPPORT
  SYSTEME
}

enum TypeActivite {
  VALIDATION
  NOUVEL_EXAMEN
  SYSTEME
  ARCHIVE
}

enum ActionAudit {
  CREATION
  CONSULTATION
  MODIFICATION
  VALIDATION
  ANNULATION
  IMPRESSION
  ACK
}

enum RoleUtilisateur {
  TECHNICIEN
  CHEF_SERVICE
  MAJOR_SERVICE
}

enum OrdreProfessionnel {
  ONM
  ONIM
  ONSFM
  ONPM
  AUTRE
  AUCUN
}

// EEG-local dossier numbering for a patient (patientId is an external id from Accueil).
// Patients themselves are no longer stored here — Accueil is the source of truth.
model EegDossier {
  id        String   @id @default(uuid())
  patientId String   @unique
  idDossier String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("eeg_dossier")
}

model Utilisateur {
  id                  String             @id @default(uuid())
  nom                 String
  prenom              String
  email               String             @unique
  telephone           String?
  matricule           String?
  role                RoleUtilisateur
  ordresProfessionnel OrdreProfessionnel @default(AUCUN)
  numeroOrdre         String?
  signatureNumerique  String?
  actif               Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  demandesPrescrits      EegDemande[]       @relation("prescripteur")
  rdvsPrescrits          EegRdv[]           @relation("prescripteurRdv")
  notificationsAssignees EegNotification[]
  activites              EegActivite[]
  resultatsValides       EegResultat[]
  rectifications         EegRectification[]
  audits                 EegAudit[]

  @@map("utilisateur")
}

model EegDemande {
  id                       String        @id @default(uuid())
  numeroEEG                String        @unique
  patientId                String
  prescripteurId           String?
  technicienId             String?
  typeEEG                  TypeEEG
  urgence                  NiveauUrgence
  motifPrescription        String
  statut                   StatutDemande @default(CREEE)
  episodeSoinsId           String
  prescriptionSourceId     String?       @unique
  prescriptionParentId     String?
  prescripteurExterneNom    String?
  prescripteurExternePrenom String?
  prescripteurExterne       Boolean     @default(false)
  dateCreation              DateTime      @default(now())
  dateRDV                  DateTime?
  dateRealisation          DateTime?
  dateValidation           DateTime?
  motifAnnulation          String?

  prescripteur  Utilisateur?      @relation("prescripteur", fields: [prescripteurId], references: [id], onDelete: SetNull)
  resultat      EegResultat?
  notifications EegNotification[]
  audits        EegAudit[]
  rdv           EegRdv?

  @@map("eeg_demande")
}

model EegRdv {
  id                      String        @id @default(uuid())
  patientId               String
  prescripteurId          String?
  demandeId               String?       @unique
  typeEEG                 String
  // Une seule salle pour l'instant (pas de sélection utilisateur) — le
  // champ existe déjà pour ne pas tout refaire quand plusieurs salles
  // réelles seront disponibles.
  salle                   String        @default("Salle EEG 1")
  priorite                NiveauUrgence
  statut                  StatutRdv     @default(EN_ATTENTE)
  dateRdv                 DateTime
  heureDebut              String
  heureFin                String
  dureeMinutes            Int
  renseignementClinique   String?
  dateRealisation         DateTime?
  technicienRealisateurId String?
  createdAt               DateTime      @default(now())

  prescripteur  Utilisateur?      @relation("prescripteurRdv", fields: [prescripteurId], references: [id], onDelete: SetNull)
  demande       EegDemande?       @relation(fields: [demandeId], references: [id])
  notifications EegNotification[]

  @@map("eeg_rdv")
}

// Compte rendu EEG — champs alignés sur le formulaire papier réel du CHU
// Andrainjato (service Neurologie). Seule cette section (CLINIQUE,
// INTERPRETATION, CONCLUSION, CONDUITE A TENIR) est saisie manuellement ;
// le reste du document (identité patient, prescripteur, personnel, dates)
// est déjà connu ailleurs dans le système et rempli automatiquement.
model EegResultat {
  id                  String    @id @default(uuid())
  demandeId           String    @unique
  fichierImagePath    String?
  nomFichierImage     String?
  dureeEnregistrement Int?

  // CLINIQUE
  aeActuel          String?
  age1ereCrise      String?
  dpm               String?
  typeCrises        String?
  autresRc          String?
  dateDerniereCrise String?

  // INTERPRETATION
  activiteDeFond    String?
  anomaliesAuRepos  String?
  testActivationHpn String?
  testActivationSli String?

  // CONCLUSION / CONDUITE A TENIR
  conclusion     String?
  conduiteATenir String?

  medecinValidateurId String?
  dateValidation      DateTime?
  estImmutable        Boolean   @default(false)
  estCritique         Boolean   @default(false)
  version             Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  demande           EegDemande         @relation(fields: [demandeId], references: [id])
  medecinValidateur Utilisateur?       @relation(fields: [medecinValidateurId], references: [id])
  rectifications    EegRectification[]

  @@map("eeg_resultat")
}

model EegRectification {
  id                String   @id @default(uuid())
  resultatId        String
  auteurId          String
  motif             String
  ancienneVersion   Json
  nouvelleVersion   Json
  dateRectification DateTime @default(now())

  resultat EegResultat @relation(fields: [resultatId], references: [id])
  auteur   Utilisateur @relation(fields: [auteurId], references: [id])

  @@map("eeg_rectification")
}

model EegNotification {
  id             String           @id @default(uuid())
  niveau         NiveauUrgence
  type           TypeNotification
  titre          String
  message        String
  patientId      String?
  patientTexte   String?
  horodatage     DateTime         @default(now())
  lu             Boolean          @default(false)
  assigneeUserId String?
  rdvId          String?
  demandeId      String?
  dateLecture    DateTime?

  assigneeUser Utilisateur?            @relation(fields: [assigneeUserId], references: [id])
  rdv          EegRdv?                 @relation(fields: [rdvId], references: [id])
  demande      EegDemande?             @relation(fields: [demandeId], references: [id])
  actions      EegNotificationAction[]

  @@map("eeg_notification")
}

model EegNotificationAction {
  id             String @id @default(uuid())
  notificationId String
  label          String
  style          String
  ordre          Int

  notification EegNotification @relation(fields: [notificationId], references: [id])

  @@map("eeg_notification_action")
}

model EegActivite {
  id          String       @id @default(uuid())
  ts          DateTime     @default(now())
  type        TypeActivite
  description String
  userId      String?
  patientId   String?

  user Utilisateur? @relation(fields: [userId], references: [id])

  @@map("eeg_activite")
}

model EegAudit {
  id            String      @id @default(uuid())
  utilisateurId String
  role          String
  action        ActionAudit
  entite        String
  entiteId      String
  patientId     String
  detail        Json?
  dateAction    DateTime    @default(now())
  demandeId     String?

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])
  demande     EegDemande? @relation(fields: [demandeId], references: [id])

  @@map("eeg_audit")
}
